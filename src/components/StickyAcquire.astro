---
import { SITE } from '../consts';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const label = lang === 'es' ? 'Adquirir el dominio' : 'Acquire this domain';
const href = lang === 'es' ? '/es/#consultar' : '/acquire/#inquire';
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-zinc-950/95 px-3 py-2.5 backdrop-blur-md md:hidden">
  <a
    href={href}
    class="flex min-h-12 items-center justify-between gap-3 rounded-2xl px-4 py-3 text-white no-underline indigo-glow"
  >
    <span class="text-sm font-semibold">{label}</span>
    <span class="font-mono text-sm font-bold">{SITE.askingPriceLabel}</span>
  </a>
</div>

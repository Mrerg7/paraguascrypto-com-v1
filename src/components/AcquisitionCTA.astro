---
import { ACQUISITION_MAILTO } from '../consts';
import Icon from './Icon.astro';

interface Props {
  label: string;
  variant?: 'accent' | 'outline' | 'white';
  class?: string;
  icon?: 'arrow-right' | 'arrow-right-long' | 'envelope' | 'shield';
  href?: string;
}

const { label, variant = 'accent', class: className = '', icon, href = ACQUISITION_MAILTO } = Astro.props;

const baseClasses =
  'inline-flex min-h-12 items-center justify-center gap-x-3 rounded-3xl px-7 py-3.5 text-base font-semibold transition-all no-underline sm:text-lg';

const variantClasses: Record<string, string> = {
  accent: 'indigo-glow text-white shadow-xl shadow-indigo-500/25 hover:brightness-110 w-full sm:w-auto',
  outline: 'border border-white/30 text-white hover:bg-white/5 w-full sm:w-auto',
  white: 'bg-white text-zinc-950 shadow-xl hover:bg-indigo-50 w-full sm:w-auto',
};
---

<a href={href} class={`${baseClasses} ${variantClasses[variant] || variantClasses.accent} ${className}`}>
  <span>{label}</span>
  {icon && <Icon name={icon} class="h-4 w-4" />}
</a>

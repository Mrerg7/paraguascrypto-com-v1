---
interface Props {
  name:
    | 'umbrella'
    | 'arrow-right'
    | 'arrow-right-long'
    | 'bars'
    | 'check'
    | 'chevron-down'
    | 'circle-check'
    | 'handshake'
    | 'file'
    | 'globe'
    | 'envelope'
    | 'shield';
  class?: string;
}

const { name, class: className = 'w-4 h-4' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'umbrella' && (
      <>
        <path d="M12 3c-5 0-9 3.2-9 7.2 0 .7.6 1.3 1.4 1.3.7 0 1.2-.4 1.5-1 .7-1.4 2.2-2.3 3.6-2.3s2.9.9 3.6 2.3c.3.6.8 1 1.5 1s1.2-.4 1.5-1c.7-1.4 2.2-2.3 3.6-2.3 1.4 0 2.9.9 3.6 2.3.3.6.8 1 1.5 1 .8 0 1.4-.6 1.4-1.3C23 6.2 17 3 12 3z" />
        <path d="M12 11.5V19a2.2 2.2 0 0 0 4.2.8" />
      </>
    )
  }
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-right-long' && <path d="M3 12h18M15 6l6 6-6 6" />}
  {name === 'bars' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'check' && <path d="M5 12.5 9.2 17 19 7" />}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {
    name === 'circle-check' && (
      <>
        <circle cx="12" cy="12" r="8.25" />
        <path d="m8.5 12.2 2.4 2.4 4.7-5" />
      </>
    )
  }
  {
    name === 'handshake' && (
      <>
        <path d="m8 13 2.2 2.2a2 2 0 0 0 2.8 0L16 12" />
        <path d="m3 11 4-4 3 1 3-3 3 2 5 1" />
        <path d="m14 14 2 2 5-4" />
      </>
    )
  }
  {
    name === 'file' && (
      <>
        <path d="M7 3.5h7l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-9.5A1.5 1.5 0 0 1 5.5 20V5A1.5 1.5 0 0 1 7 3.5z" />
        <path d="M14 3.5V8h4.5M8.5 12.5h7M8.5 16h5" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="8.25" />
        <path d="M3.8 12h16.4M12 3.8c2.2 2.3 3.3 5.1 3.3 8.2s-1.1 5.9-3.3 8.2c-2.2-2.3-3.3-5.1-3.3-8.2s1.1-5.9 3.3-8.2z" />
      </>
    )
  }
  {
    name === 'envelope' && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3.5 19 6.2v5.4c0 4-2.8 6.7-7 8.9-4.2-2.2-7-4.9-7-8.9V6.2L12 3.5z" />
        <path d="m9 12 2 2 4-4.2" />
      </>
    )
  }
</svg>

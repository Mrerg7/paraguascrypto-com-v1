---
import { getEntry } from 'astro:content';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SITE } from '../consts';
import { FAQS_EN } from '../data/faq';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbNode, faqNode, graph, productNode, webPageNode, websiteNode } from '../lib/schema';

const siteEntry = await getEntry('site', 'default');
if (!siteEntry) throw new Error('Site config missing');

const title = 'paraguascrypto.com buyer FAQ — price, escrow, and meaning';
const description =
  'Answers for buyers of paraguascrypto.com: asking price $27,500, what paraguas means, how Escrow.com transfer works, and what is included in the sale.';

const jsonLd = graph([
  websiteNode(),
  productNode(),
  webPageNode({ path: '/faq/', title, description, lang: 'en-US' }),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq/' },
  ]),
  faqNode(FAQS_EN),
]);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main class="mx-auto max-w-3xl px-4 pb-16 pt-24 sm:px-6 sm:pt-28">
    <nav class="mb-6 text-sm text-zinc-500" aria-label="Breadcrumb">
      <a href="/" class="no-underline hover:text-white">Home</a>
      <span class="px-2">/</span>
      <span class="text-zinc-300">FAQ</span>
    </nav>
    <p class="text-xs font-bold uppercase tracking-[2px] text-indigo-400">Buyers</p>
    <h1 class="section-header mt-3">Questions before you <span class="indigo-gradient">acquire the .com</span></h1>
    <p class="mt-4 text-lg text-zinc-400">
      Straight answers. Asking price {SITE.askingPriceLabel}. Contact {SITE.acquisitionEmail}.
    </p>

    <div class="mt-10 divide-y divide-zinc-800 border-y border-zinc-800">
      {FAQS_EN.map((faq) => (
        <details class="group py-5">
          <summary class="cursor-pointer list-none text-lg font-semibold tracking-tight text-white marker:content-none">
            <span class="flex items-start justify-between gap-4">
              {faq.question}
              <span class="mt-1 text-indigo-300 transition group-open:rotate-45" aria-hidden="true">+</span>
            </span>
          </summary>
          <p class="mt-3 text-base leading-relaxed text-zinc-400">{faq.answer}</p>
        </details>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="/acquire/" class="inline-flex min-h-12 items-center justify-center rounded-3xl px-6 py-3 font-semibold text-white no-underline indigo-glow">
        Submit an offer
      </a>
      <a href="/brand/" class="inline-flex min-h-12 items-center justify-center rounded-3xl border border-zinc-700 px-6 py-3 font-semibold text-zinc-200 no-underline">
        Brand and pronunciation
      </a>
    </div>
  </main>
  <Footer disclaimer={siteEntry.data.disclaimer} />
</BaseLayout>

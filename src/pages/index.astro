---
import { getCollection, getEntry } from 'astro:content';
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const siteEntry = await getEntry('site', 'default');
if (!siteEntry) throw new Error('Site config missing');
const siteConfig = siteEntry.data;

const reasons = (await getCollection('reasons')).sort(
  (a, b) => a.data.number - b.data.number,
);
---

<BaseLayout>
  <Nav />

  <main>
    <!-- HERO -->
    <header class="hero-bg min-h-[100dvh] flex items-center pt-16 relative">
      <div class="max-w-screen-xl mx-auto px-6 pt-12 pb-20">
        <div class="max-w-5xl">
          <!-- Badge -->
          <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 mb-8">
            <div class="flex items-center gap-x-1.5">
              <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
              <span class="text-emerald-400 text-xs font-semibold tracking-[1.5px] uppercase">Premium .com • Available Now</span>
            </div>
          </div>

          <div class="max-w-4xl">
            <h1 class="font-display text-[4rem] md:text-[5.5rem] leading-[0.95] tracking-[-4px] font-extrabold mb-2">
              <span class="indigo-gradient">Paraguascrypto</span><br />
              <span class="text-5xl md:text-6xl text-white tracking-tight">.com</span>
            </h1>

            <p class="text-3xl md:text-4xl text-white font-display font-semibold tracking-tight mt-2 mb-3">
              Crypto Umbrella
            </p>

            <p class="max-w-2xl text-xl md:text-2xl text-zinc-400 font-light tracking-tight leading-tight mb-10">
              The premium domain that offers protection, unity, and comprehensive coverage — sheltering the next generation of digital asset platforms under one trusted roof.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <AcquisitionCTA label="Secure This Domain" variant="white" icon="fa-arrow-right-long" />
            <a href="#opportunity" class="px-8 py-4 border border-white/30 hover:bg-white/5 active:bg-white/10 transition-all font-semibold text-lg rounded-3xl flex items-center justify-center gap-x-2 w-full sm:w-auto text-white no-underline">
              <span>Explore the Opportunity</span>
            </a>
          </div>

          <div class="mt-10 flex items-center gap-x-8 text-sm">
            <div class="flex items-center gap-x-2 text-zinc-400">
              <i class="fa-solid fa-check text-emerald-400"></i>
              <span>Protection & Coverage</span>
            </div>
            <div class="flex items-center gap-x-2 text-zinc-400">
              <i class="fa-solid fa-check text-emerald-400"></i>
              <span>Unified Brand Power</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 hidden lg:block">
        <div class="flex flex-col items-center text-xs tracking-[2px] text-zinc-500">
          <span>SCROLL TO EXPLORE</span>
          <i class="fa-solid fa-chevron-down mt-1.5 animate-bounce"></i>
        </div>
      </div>
    </header>

    <!-- TRUST BAR -->
    <div class="border-b border-zinc-800 bg-zinc-900/60 py-5">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="flex flex-wrap justify-center md:justify-between items-center gap-x-8 gap-y-3 text-sm">
          {
            siteConfig.trustPoints.map((point) => (
              <div class="flex items-center gap-x-2 text-zinc-400">
                <i class="fa-solid fa-circle-check text-indigo-400"></i>
                <span class="font-medium">{point}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- THE MEANING -->
    <section id="meaning" class="max-w-screen-xl mx-auto px-6 pt-20 pb-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-14">
          <div class="inline-block px-4 py-1 rounded-3xl bg-indigo-400/10 text-indigo-400 text-xs font-bold tracking-[2px] mb-4">THE NAME</div>
          <h2 class="section-header tracking-[-2.5px]">Paraguascrypto means<br /><span class="indigo-gradient">Crypto Umbrella</span></h2>
          <p class="mt-4 text-xl text-zinc-400">Protection. Coverage. Unity. The name that shelters and unifies in the complex world of digital assets.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div>
            <div class="prose prose-invert prose-lg max-w-none text-zinc-300 space-y-4">
              <p class="leading-relaxed">"Paraguas" is the Spanish word for <strong class="text-white">umbrella</strong> — a universal symbol of protection, shelter, and comprehensive coverage understood across the Spanish-speaking world and beyond.</p>
              <p class="leading-relaxed">Combined with "Crypto", it creates a powerful and versatile brand name that communicates:</p>
            </div>

            <ul class="mt-6 space-y-4 text-lg">
              <li class="flex items-start gap-x-3">
                <i class="fa-solid fa-check-circle text-indigo-400 mt-1.5 flex-shrink-0"></i>
                <span><strong>Protection & Security</strong> — In a volatile market, users and projects need an umbrella of safety</span>
              </li>
              <li class="flex items-start gap-x-3">
                <i class="fa-solid fa-check-circle text-indigo-400 mt-1.5 flex-shrink-0"></i>
                <span><strong>Comprehensive Coverage</strong> — One brand that covers multiple needs, products, or chains</span>
              </li>
              <li class="flex items-start gap-x-3">
                <i class="fa-solid fa-check-circle text-indigo-400 mt-1.5 flex-shrink-0"></i>
                <span><strong>Unity & Integration</strong> — Bringing disparate elements together under one trusted roof</span>
              </li>
              <li class="flex items-start gap-x-3">
                <i class="fa-solid fa-check-circle text-indigo-400 mt-1.5 flex-shrink-0"></i>
                <span><strong>Trust & Reliability</strong> — An umbrella implies stability and care in uncertain conditions</span>
              </li>
            </ul>
          </div>

          <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-10">
            <div class="text-sm uppercase tracking-[2px] text-zinc-500 mb-4">VERSATILE BRAND POSITIONING</div>
            <div class="space-y-6 text-lg">
              <div>
                <div class="font-mono text-xs text-indigo-400 tracking-widest mb-1">SPANISH + UNIVERSAL SYMBOL</div>
                <div class="text-3xl font-semibold tracking-tight">Paraguas = Umbrella</div>
              </div>
              <div class="pt-4 border-t border-zinc-700">
                <div class="text-zinc-400">In crypto, where volatility, complexity, and risk are constant, the most valuable brands are those that offer users and builders a sense of protection and comprehensive coverage.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE OPPORTUNITY -->
    <section id="opportunity" class="bg-zinc-900 border-y border-zinc-800 py-20">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <div class="inline-block px-4 py-1 rounded-3xl bg-indigo-400/10 text-indigo-400 text-xs font-bold tracking-[2px] mb-4">THE CRYPTO LANDSCAPE</div>
            <h2 class="section-header tracking-[-2.5px]">In crypto, everyone<br />needs an <span class="indigo-gradient">umbrella</span>.</h2>
          </div>

          <div class="prose prose-invert prose-lg max-w-none text-zinc-300 space-y-5">
            <p class="text-xl leading-relaxed">With the advent of cryptocurrency, individuals and organizations gained unprecedented power to create wealth from anywhere in the world. But with that power came new risks, complexity, and fragmentation.</p>

            <p>Users juggle multiple wallets, chains, protocols, and assets. Projects must navigate security threats, regulatory uncertainty, and market volatility. Institutions demand robust protection and unified solutions.</p>

            <p>The brands that will win in this environment are those that provide <strong class="text-white">shelter</strong> — comprehensive platforms, security layers, risk management tools, and unifying ecosystems that make crypto safer, simpler, and more accessible for everyone.</p>
          </div>

          <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="reason-card bg-zinc-950 border border-zinc-800 rounded-2xl p-6 text-center">
              <div class="text-4xl font-semibold text-white tracking-tighter">Risk</div>
              <div class="text-sm text-zinc-400 mt-1">Management</div>
            </div>
            <div class="reason-card bg-zinc-950 border border-zinc-800 rounded-2xl p-6 text-center">
              <div class="text-4xl font-semibold text-white tracking-tighter">Security</div>
              <div class="text-sm text-zinc-400 mt-1">First Priority</div>
            </div>
            <div class="reason-card bg-zinc-950 border border-zinc-800 rounded-2xl p-6 text-center">
              <div class="text-4xl font-semibold text-white tracking-tighter">Unity</div>
              <div class="text-sm text-zinc-400 mt-1">Across Chains</div>
            </div>
            <div class="reason-card bg-zinc-950 border border-zinc-800 rounded-2xl p-6 text-center">
              <div class="text-4xl font-semibold text-white tracking-tighter">Trust</div>
              <div class="text-sm text-zinc-400 mt-1">Built Over Time</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY PREMIUM -->
    <section id="why-premium" class="max-w-screen-xl mx-auto px-6 pt-20 pb-16">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <div class="inline-block px-4 py-1 rounded-3xl bg-indigo-400/10 text-indigo-400 text-xs font-bold tracking-[2px] mb-4">PREMIUM STRATEGIC ASSET</div>
        <h2 class="section-header tracking-[-2.5px]">Why Paraguascrypto.com<br />commands a <span class="indigo-gradient">high acquisition price</span></h2>
        <p class="mt-5 text-xl text-zinc-400">This is a rare, memorable, and highly ownable name that instantly communicates protection, coverage, and comprehensive solutions in one of the highest-growth sectors of the 21st century.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {
          reasons.map((reason) => (
            <div class="reason-card bg-zinc-900 border border-zinc-800 rounded-3xl p-8 flex flex-col">
              <div class="w-12 h-12 flex items-center justify-center rounded-2xl indigo-glow bg-opacity-10 mb-6">
                <span class="text-2xl font-extrabold font-display text-white">{String(reason.data.number).padStart(2, '0')}</span>
              </div>
              <h3 class="font-semibold text-xl tracking-tight mb-3">{reason.data.title}</h3>
              <p class="text-zinc-400 leading-relaxed flex-grow">{reason.data.description}</p>
            </div>
          ))
        }
      </div>

      <div class="max-w-3xl mx-auto mt-12 text-center text-sm text-zinc-500 border-t border-zinc-800 pt-8">
        In a market where clear, emotionally resonant, and strategically versatile .com domains command significant premiums, Paraguascrypto.com stands out as a rare and ownable asset with immediate brand power and long-term flexibility.
      </div>
    </section>

    <!-- USE CASES -->
    <section id="use-cases" class="bg-zinc-900 border-y border-zinc-800 py-20">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center mb-14">
          <div class="inline-block px-4 py-1 rounded-3xl bg-indigo-400/10 text-indigo-400 text-xs font-bold tracking-[2px] mb-4">BUILT FOR PROTECTION & SCALE</div>
          <h2 class="section-header tracking-[-2.5px]">Perfect for platforms that<br />cover and protect</h2>
          <p class="mt-3 text-xl text-zinc-400">This name gives you instant positioning as the comprehensive, trustworthy solution users and projects can rely on.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {
            siteConfig.useCaseCategories.map((useCase, i) => (
              <div class="use-case-card bg-zinc-950 border border-zinc-800 hover:border-indigo-400/60 rounded-3xl p-8 flex flex-col">
                <div class="flex items-center gap-x-4 mb-5">
                  <div class="w-11 h-11 rounded-2xl indigo-glow flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-bold text-lg">{i + 1}</span>
                  </div>
                  <div>
                    <div class="font-semibold text-lg tracking-tight">{useCase.title}</div>
                  </div>
                </div>
                <p class="text-zinc-400 flex-grow text-[15px] leading-relaxed">{useCase.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- THIS IS MORE THAN A DOMAIN -->
    <section class="max-w-screen-xl mx-auto px-6 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mx-auto mb-8 inline-flex items-center justify-center w-20 h-20 rounded-full bg-white/5 border border-white/10">
          <i class="fa-solid fa-umbrella text-4xl indigo-gradient"></i>
        </div>

        <h2 class="font-display text-5xl md:text-6xl tracking-[-2.5px] leading-none font-extrabold mb-6">
          This Is More Than a Domain —<br />
          <span class="indigo-gradient">It's the Umbrella Your Crypto Brand Needs</span>
        </h2>

        <div class="prose prose-invert prose-lg max-w-2xl mx-auto text-zinc-300 space-y-4">
          <p>
            In a digital landscape crowded with generic names and forgettable handles, <strong class="text-white">paraguascrypto.com</strong> stands apart. It is the name that positions its owner as the trusted shelter in an industry defined by volatility — protective, comprehensive, and globally resonant.
          </p>
          <p>
            Whether you are the founder building the next category-defining security platform, the entrepreneur launching a multi-product ecosystem, or the investor who recognizes long-term brand equity in a name that owns the narrative of protection and coverage, this domain is ready to serve as the cornerstone.
          </p>
        </div>
      </div>
    </section>

    <!-- ACQUISITION SECTION -->
    <section class="bg-zinc-900 border-y border-zinc-800 py-16">
      <div class="max-w-screen-xl mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <div class="inline-block px-5 py-1.5 rounded-3xl indigo-glow text-white text-xs font-extrabold tracking-[1.5px] mb-4">ACQUISITION</div>
            <h2 class="section-header tracking-[-2px]">Ready to own<br />the Crypto Umbrella?</h2>
          </div>

          <div class="bg-zinc-950 border border-zinc-700 rounded-3xl p-10 md:p-14">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-y-8">
              <div>
                <div class="text-sm uppercase tracking-[3px] text-indigo-400 font-bold mb-2">Premium Strategic Asset</div>
                <div class="flex items-baseline gap-x-2">
                  <span class="text-5xl font-extrabold tabular-nums tracking-[-2px]">Price on Request</span>
                </div>
                <div class="text-sm text-zinc-400 mt-1">One-time acquisition • Full ownership transfer</div>

                <div class="mt-6 text-sm max-w-xs">
                  <div class="flex items-center gap-x-2 text-emerald-400">
                    <i class="fa-solid fa-check"></i>
                    <span class="font-medium">Paraguascrypto.com is available for private acquisition by teams building protective, comprehensive, or unifying solutions in crypto</span>
                  </div>
                </div>
              </div>

              <div class="lg:text-right">
                <AcquisitionCTA label="Submit Acquisition Inquiry" variant="accent" icon="fa-arrow-right-long" />
                <div class="mt-4 text-xs text-zinc-400">Serious buyers only • Escrow protected</div>
              </div>
            </div>

            <div class="mt-10 pt-8 border-t border-zinc-700 grid grid-cols-1 sm:grid-cols-3 gap-y-6 text-sm">
              <div>
                <div class="font-semibold mb-1 flex items-center gap-x-2"><i class="fa-solid fa-handshake text-indigo-400"></i> <span>Transaction</span></div>
                <div class="text-zinc-400">Handled via Escrow.com or your preferred platform. Full domain push + DNS control transfer.</div>
              </div>
              <div>
                <div class="font-semibold mb-1 flex items-center gap-x-2"><i class="fa-solid fa-file-contract text-indigo-400"></i> <span>Confidential</span></div>
                <div class="text-zinc-400">All inquiries are handled confidentially. Pricing reflects the name's strong emotional resonance, versatility as an umbrella brand, cross-cultural appeal, and immediate ability to communicate protection.</div>
              </div>
              <div>
                <div class="font-semibold mb-1 flex items-center gap-x-2"><i class="fa-solid fa-globe text-indigo-400"></i> <span>Why Now?</span></div>
                <div class="text-zinc-400">The brands that claim clear, ownable language around protection and comprehensive coverage in crypto now will hold mindshare for decades.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <div class="bg-gradient-to-b from-zinc-900 to-zinc-950 py-16">
      <div class="max-w-screen-xl mx-auto px-6 text-center">
        <div class="max-w-lg mx-auto">
          <h3 class="font-display text-5xl tracking-[-2px] font-extrabold mb-4">Protection has<br />a new name.</h3>
          <p class="text-xl text-zinc-300 mb-8">Claim the premium domain that defines the era of comprehensive crypto coverage.</p>

          <AcquisitionCTA label="Inquire to Acquire" variant="accent" />
        </div>
      </div>
    </div>
  </main>

  <Footer disclaimer={siteConfig.disclaimer} />
</BaseLayout>

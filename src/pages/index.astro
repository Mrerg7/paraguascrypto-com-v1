---
import { getCollection, getEntry } from 'astro:content';
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { graph, organizationNode, productNode, webPageNode, websiteNode } from '../lib/schema';

const siteEntry = await getEntry('site', 'default');
if (!siteEntry) throw new Error('Site config missing');
const siteConfig = siteEntry.data;

const reasons = (await getCollection('reasons')).sort((a, b) => a.data.number - b.data.number);

const jsonLd = graph([
  websiteNode(),
  organizationNode(),
  productNode(),
  webPageNode({
    path: '/',
    title: SITE.title,
    description: SITE.description,
    lang: 'en-US',
  }),
]);

const steps = [
  { n: '1', title: 'Inquire', body: 'Name, email, and your offer. A reply comes from sales@desertrich.com.' },
  { n: '2', title: 'Escrow', body: 'Terms lock on Escrow.com, or another escrow desk both sides accept.' },
  { n: '3', title: 'Transfer', body: 'Domain push and DNS control after funds clear. Usually a few business days.' },
];
---

<BaseLayout jsonLd={jsonLd} preloadHero>
  <Nav />

  <main>
    <header class="hero-bg relative flex items-center pt-20 sm:min-h-[100dvh] sm:pt-16">
      <div class="mx-auto max-w-screen-xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 sm:pt-12">
        <div class="max-w-5xl">
          <div class="mb-6 inline-flex items-center gap-x-2 rounded-3xl border border-white/20 bg-white/10 px-3 py-1.5 backdrop-blur-md sm:mb-8 sm:px-4">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[1.4px] text-emerald-400 sm:text-xs">Premium .com for sale · Available now</span>
          </div>

          <h1 class="hero-title font-display max-w-4xl font-extrabold">
            <span class="indigo-gradient">Paraguascrypto</span><br />
            <span class="text-[0.62em] tracking-tight text-white">.com</span>
          </h1>

          <p class="mt-3 font-display text-2xl font-semibold tracking-tight text-white sm:text-4xl">
            Crypto Umbrella
          </p>

          <p class="mb-8 mt-3 max-w-2xl text-base font-light leading-snug tracking-tight text-zinc-300 sm:text-2xl">
            The .com that means protection, coverage, and one roof over a crypto brand. Asking price
            <strong class="font-semibold text-white">{SITE.askingPriceLabel}</strong>.
          </p>

          <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <AcquisitionCTA label="Acquire for $27,500" variant="white" icon="arrow-right-long" href="/acquire/" />
            <a href="#meaning" class="inline-flex min-h-12 items-center justify-center rounded-3xl border border-white/30 px-7 py-3.5 text-base font-semibold text-white no-underline transition hover:bg-white/5">
              Why this name
            </a>
          </div>

          <ul class="mt-8 flex flex-col gap-2 text-sm text-zinc-400 sm:flex-row sm:gap-8">
            <li class="flex items-center gap-x-2">
              <Icon name="check" class="h-4 w-4 text-emerald-400" />
              <span>Paraguas = umbrella, not Paraguay</span>
            </li>
            <li class="flex items-center gap-x-2">
              <Icon name="check" class="h-4 w-4 text-emerald-400" />
              <span>Escrow.com transfer</span>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <div class="border-b border-zinc-800 bg-zinc-900/60 py-4">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6">
        <ul class="flex flex-col gap-2 text-sm sm:flex-row sm:flex-wrap sm:justify-between sm:gap-x-6 sm:gap-y-3">
          {siteConfig.trustPoints.map((point) => (
            <li class="flex items-center gap-x-2 text-zinc-400">
              <Icon name="circle-check" class="h-4 w-4 shrink-0 text-indigo-400" />
              <span class="font-medium">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section id="meaning" class="mx-auto max-w-screen-xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20">
      <div class="mx-auto max-w-4xl">
        <div class="mb-10 text-center sm:mb-14">
          <div class="mb-4 inline-block rounded-3xl bg-indigo-400/10 px-4 py-1 text-xs font-bold tracking-[2px] text-indigo-400">THE NAME</div>
          <h2 class="section-header">Paraguascrypto means <span class="indigo-gradient">Crypto Umbrella</span></h2>
          <p class="mt-4 text-lg text-zinc-400">Protection. Coverage. One brand. <a class="text-indigo-300 underline decoration-indigo-400/40 underline-offset-4" href="/brand/">Read the brand notes</a>, including pronunciation and the Paraguay mix-up.</p>
        </div>

        <div class="grid items-start gap-8 md:grid-cols-2 md:gap-10">
          <div>
            <div class="space-y-4 text-base leading-relaxed text-zinc-300 sm:text-lg">
              <p>"Paraguas" is the Spanish word for <strong class="text-white">umbrella</strong> — shelter and full coverage, understood across the Spanish-speaking world.</p>
              <p>It is not a misspelling of Paraguay. The name is paraguas + crypto: a brand that says safety without borrowing a country.</p>
            </div>
            <ul class="mt-6 space-y-4 text-base sm:text-lg">
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="mt-1 h-4 w-4 shrink-0 text-indigo-400" />
                <span><strong>Protection</strong> — a signal buyers and users already understand</span>
              </li>
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="mt-1 h-4 w-4 shrink-0 text-indigo-400" />
                <span><strong>Coverage</strong> — one name over several products, chains, or policies</span>
              </li>
              <li class="flex items-start gap-x-3">
                <Icon name="circle-check" class="mt-1 h-4 w-4 shrink-0 text-indigo-400" />
                <span><strong>Reach</strong> — clear in English as a symbol, immediate in Spanish as a word</span>
              </li>
            </ul>
          </div>

          <div class="rounded-3xl border border-zinc-800 bg-zinc-900 p-6 sm:p-10">
            <div class="mb-4 text-xs uppercase tracking-[2px] text-zinc-500">Say it once</div>
            <div class="font-mono text-xs tracking-widest text-indigo-400">pah-RAH-gwahs · KRYP-toh</div>
            <div class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Paraguas = umbrella</div>
            <p class="mt-4 border-t border-zinc-700 pt-4 text-zinc-400">
              In a market built on volatility, the brands that win sound like shelter. This .com already says that in two languages.
            </p>
            <a href="/es/" class="mt-6 inline-flex text-sm font-semibold text-indigo-300 no-underline hover:text-white" hrefLang="es">Leer en español →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="opportunity" class="border-y border-zinc-800 bg-zinc-900 py-16 sm:py-20">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6">
        <div class="mx-auto max-w-4xl">
          <div class="mb-8 text-center sm:mb-12">
            <div class="mb-4 inline-block rounded-3xl bg-indigo-400/10 px-4 py-1 text-xs font-bold tracking-[2px] text-indigo-400">THE MARKET</div>
            <h2 class="section-header">In crypto, everyone needs an <span class="indigo-gradient">umbrella</span>.</h2>
          </div>
          <div class="space-y-4 text-base leading-relaxed text-zinc-300 sm:text-lg">
            <p>Users hold wallets, chains, and protocols that do not talk to each other. Projects carry security risk, regulatory fog, and drawdowns. Institutions ask for one counterparty that covers the stack.</p>
            <p>The names that get remembered are the ones that promise <strong class="text-white">shelter</strong> — insurance, custody, hedging, or a multi-product roof. Paraguascrypto.com is that sentence, already registered as a .com.</p>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
            {[
              ['Risk', 'Management'],
              ['Security', 'First'],
              ['Unity', 'Across chains'],
              ['Trust', 'Over time'],
            ].map(([title, sub]) => (
              <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-4 text-center sm:p-6">
                <div class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{title}</div>
                <div class="mt-1 text-sm text-zinc-400">{sub}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="why-premium" class="mx-auto max-w-screen-xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20">
      <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
        <div class="mb-4 inline-block rounded-3xl bg-indigo-400/10 px-4 py-1 text-xs font-bold tracking-[2px] text-indigo-400">WHY THIS PRICE</div>
        <h2 class="section-header">Why buyers pay for a name that already <span class="indigo-gradient">means the category</span></h2>
        <p class="mt-5 text-lg text-zinc-400">Asking price {SITE.askingPriceLabel}. The .com is ownable, sayable, and specific. You are not buying a syllable. You are buying the metaphor.</p>
      </div>

      <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-2 lg:grid-cols-3">
        {reasons.map((reason) => (
          <article class="reason-card flex flex-col rounded-3xl border border-zinc-800 bg-zinc-900 p-6 sm:p-8">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl font-display text-lg font-extrabold text-white indigo-glow">
              {String(reason.data.number).padStart(2, '0')}
            </div>
            <h3 class="mb-3 text-xl font-semibold tracking-tight">{reason.data.title}</h3>
            <p class="flex-grow leading-relaxed text-zinc-400">{reason.data.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="use-cases" class="border-y border-zinc-800 bg-zinc-900 py-16 sm:py-20">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6">
        <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
          <div class="mb-4 inline-block rounded-3xl bg-indigo-400/10 px-4 py-1 text-xs font-bold tracking-[2px] text-indigo-400">WHO IT FITS</div>
          <h2 class="section-header">Built for platforms that cover and protect</h2>
          <p class="mt-3 text-lg text-zinc-400">Use it as the public name the day the transfer lands. No product ships with the domain — the brand does.</p>
        </div>
        <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-2 lg:grid-cols-3">
          {siteConfig.useCaseCategories.map((useCase, i) => (
            <article class="use-case-card flex flex-col rounded-3xl border border-zinc-800 bg-zinc-950 p-6 sm:p-8">
              <div class="mb-4 flex items-center gap-x-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl font-bold text-white indigo-glow">{i + 1}</div>
                <h3 class="text-lg font-semibold tracking-tight">{useCase.title}</h3>
              </div>
              <p class="text-[15px] leading-relaxed text-zinc-400">{useCase.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-screen-xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-4xl text-center">
        <div class="mx-auto mb-6 inline-flex h-16 w-16 items-center justify-center rounded-full border border-white/10 bg-white/5 text-indigo-300">
          <Icon name="umbrella" class="h-8 w-8" />
        </div>
        <h2 class="section-header">More than a domain. <span class="indigo-gradient">The umbrella the brand is missing.</span></h2>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-zinc-300 sm:text-lg">
          Generic crypto names are leased attention. <strong class="text-white">paraguascrypto.com</strong> is a position: the shelter in a volatile category, readable in Spanish, ownable in English, and listed at a price a serious acquirer can underwrite today.
        </p>
      </div>
    </section>

    <section id="how" class="border-y border-zinc-800 bg-zinc-900 py-16 sm:py-20">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6">
        <div class="mx-auto max-w-4xl">
          <div class="mb-8 text-center">
            <div class="mb-4 inline-block rounded-3xl px-4 py-1 text-xs font-extrabold tracking-[1.5px] text-white indigo-glow">HOW TO BUY</div>
            <h2 class="section-header">Three steps. Then the name is yours.</h2>
          </div>
          <ol class="grid gap-4 md:grid-cols-3">
            {steps.map((step) => (
              <li class="rounded-3xl border border-zinc-800 bg-zinc-950 p-6">
                <div class="font-display text-3xl font-bold text-indigo-300">{step.n}</div>
                <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-zinc-400">{step.body}</p>
              </li>
            ))}
          </ol>
          <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <AcquisitionCTA label={`Start at ${SITE.askingPriceLabel}`} variant="accent" icon="arrow-right" href="/acquire/" />
            <a href="/faq/" class="inline-flex min-h-12 items-center justify-center rounded-3xl border border-zinc-700 px-6 py-3 text-sm font-semibold text-zinc-300 no-underline hover:text-white">Read the buyer FAQ</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer disclaimer={siteConfig.disclaimer} />
</BaseLayout>
